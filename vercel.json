{
  "rewrites": [{ "source": "/((?!static/|models/|sw\\.js|manifest\\.json|favicon\\.ico|logo).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
