# Anthropic API (AI receptionist + SOAP note drafting)
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-opus-4-8
ANTHROPIC_MODEL=claude-opus-4-8

# Twilio (SMS + voice)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+15550001111

# Public base URL for webhook signature validation, e.g. https://clinic.example.com
PUBLIC_URL=

# Server
PORT=3000

# Where the JSON datastore lives (created automatically)
DATA_DIR=./data

# Set to 1 to log outbound SMS/API calls instead of sending them
DRY_RUN=
